  "components": [
    {
      "name": "Regional assessment action",
      "kind": "button",
      "refersTo": "soil-assess",
      "description": "Primary action; disabled during retrieval or invalid bounds.",
      "html": "<button class=\"ds-assess\">Assess selected region<span aria-hidden=\"true\">↗</span></button>",
      "css": ".ds-assess{font-family:\"IBM Plex Sans\",sans-serif;display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:12px 14px;min-height:44px;background:var(--ink,#18221e);color:var(--surface,#fff);border:0;border-radius:6px;font-size:14px;font-weight:500;cursor:pointer}.ds-assess:hover:not(:disabled){background:#32453a}.ds-assess:focus-visible{outline:2px solid var(--focus,#126a82);outline-offset:3px}.ds-assess:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Soil coordinate field",
      "kind": "input",
      "refersTo": "soil-input",
      "description": "Visible label and native keyboard coordinate editing.",
      "html": "<label class=\"ds-coordinate\">West<input type=\"number\" step=\"0.001\" value=\"123.7\"></label>",
      "css": ".ds-coordinate{font-family:\"IBM Plex Sans\",sans-serif;display:grid;gap:6px;font-size:12px;color:var(--muted,#59665f)}.ds-coordinate input{font-family:\"IBM Plex Sans\",sans-serif;min-width:0;width:100%;height:40px;padding:7px 9px;background:var(--surface,#fff);border:1px solid #cdd6d0;border-radius:6px;color:var(--ink,#18221e);font-size:13px;caret-color:var(--accent,#246c61)}.ds-coordinate input:hover{border-color:#8b9e91}.ds-coordinate input:focus{outline:2px solid var(--focus,#126a82);outline-offset:2px}@media(max-width:540px){.ds-coordinate input{min-height:44px;font-size:14px}}"
    },
    {
      "name": "Global navigation",
      "kind": "nav",
      "description": "Default soil view with an underlined current state; planning link is host-dependent.",
      "html": "<nav class=\"ds-soil-nav\" aria-label=\"Workspace\"><span aria-current=\"page\">Soil explorer</span><a href=\"?workspace=planning\">Climate &amp; economics ↗</a></nav>",
      "css": ".ds-soil-nav{font-family:\"IBM Plex Sans\",sans-serif;display:flex;align-items:center;gap:28px;font-size:14px}.ds-soil-nav span,.ds-soil-nav a{display:flex;align-items:center;gap:8px;padding:12px 0;text-decoration:none;color:var(--muted,#59665f)}.ds-soil-nav [aria-current]{color:var(--ink,#18221e);border-bottom:2px solid var(--accent,#246c61)}.ds-soil-nav a:focus-visible{outline:2px solid var(--focus,#126a82);outline-offset:3px}@media(max-width:540px){.ds-soil-nav{gap:20px;font-size:12px}}"
    },
    {
      "name": "Active region selection",
