      "css": ".ds-region{font-family:\"IBM Plex Sans\",sans-serif;display:flex;gap:8px;align-items:center;min-height:40px;padding:9px 12px;border:1px solid var(--accent,#246c61);border-radius:6px;background:var(--accent,#246c61);color:var(--surface,#fff);font-size:13px;cursor:pointer}.ds-region:focus-visible{outline:2px solid var(--focus,#126a82);outline-offset:3px}@media(max-width:540px){.ds-region{min-height:44px;padding:9px;font-size:12px}}"
    },
